# ---------------------------------------------------------------------------
# PROGRAM COPY (nearest-copy endpoint, independent layout). Generated from
# Scripts/Analysis/thesis_expected_values.yaml by make_harness_copies.py with the
# canonical result paths and the thesis directory remapped to their _nearest
# counterparts. VALUES ARE STILL THE CANONICAL ONES until Phase 7 re-transcribes
# them from thesis_latex_nearest/. The canonical yaml is untouched.
# ---------------------------------------------------------------------------
# =============================================================================
# Numbers the thesis prints, with where they appear and what recomputes them.
#
# Read by Scripts/Analysis/thesis_assertions.py, which is the last cell of
# Thesis_Reproduction.ipynb. Every entry names its source in the document so a
# later edit to either side can be traced to the other.
#
# Figure and table numbers are the SHORT build (Thesis_short.tex, 39 figures and
# 27 tables). The retired full build numbered them differently.
#
# A mismatch here is a finding, not a bug to paper over. The harness reports it
# and changes nothing.
# =============================================================================

meta:
  reference_convention: nearest-copy   # program copy; see header
  thesis_main: thesis_latex_nearest/body_main_short.tex
  thesis_appendix: thesis_latex_nearest/body_appendix_short.tex
  build: short
  recorded: "2026-09-02"

# -----------------------------------------------------------------------------
# Cohort
# -----------------------------------------------------------------------------
cohort:
  source: "body_main_short.tex:192"
  benchmark_ids: 308
  analysed_complexes: 303
  note: >-
    308 ligands were prepared and docked; DiffDock produced no pose for five, so
    303 carry a complete three-tool record and are the analysed set. Every paired
    test uses the 303.
  orai_frames: 4
  orai_experimental_units: 12          # 3 modulators x 4 frames
  orai_control_units: 1232             # 308 ligands x 4 frames

# -----------------------------------------------------------------------------
# Determinism evidence (App. B; the reproducibility hook)
# -----------------------------------------------------------------------------
determinism:
  source: 'body_appendix_short.tex, "Orai1 Panels"'
  diffdock_seeded_logs:
    benchmark: 0
    orai_control: 0
    orai_experimental: 24
  note: >-
    The local DiffDock seed patch prints "[repro] seeded" when it fires. Counting
    that marker in the stored run logs is what classifies each arm. The appendix
    states the same asymmetry: the hook appears in the experimental run logs and
    is absent from the control ones.

# -----------------------------------------------------------------------------
# Table 1 - Pose Production and Physical-Validity Summary
# -----------------------------------------------------------------------------
# Gates, established by reproducing all 70 printed cells:
#   validity    pb_valid
#   near-native rmsd <= 2.0                      (NOT conditioned on validity)
#   form        bestfit_rmsd <= 1.0 AND rmsd < 1000
#   triple      pb_valid AND rmsd <= 2.0 AND bestfit_rmsd <= 1.0
#
# The near-native column being unconditioned is easy to get wrong, because the
# COST table's complex counts use the validity-aware version of the same gate.
# Both are checked below, which is how the difference stays visible.
table_1:
  source: "body_main_short.tex:261, tab:results-pose-production"
  input: posebusters_results/benchmark_matched_equibind/dock/pose_comparison_report_nearest/per_pose_metrics.csv
  columns: [poses, valid_complexes, valid_poses, valid_pct,
            near_complexes, near_poses, near_pct,
            form_complexes, form_poses, form_pct,
            triple_complexes, triple_poses, triple_pct]
  rows:
    autodock_mgltools_exh128:       [8976, 303, 8943, 99.6, 202,  307,  3.4, 225, 2848, 31.7, 164,  221,  2.5]
    autodock_mgltools_exh128_gnina: [8976, 301, 8880, 98.9, 202,  319,  3.6, 227, 2836, 31.6, 160,  221,  2.5]
    diffdock:                       [9013, 242, 2198, 24.4, 152, 1683, 18.7, 225, 4012, 44.5,  83,  722,  8.0]
    diffdock_smina:                 [8993, 300, 7597, 84.5, 173, 1715, 19.1, 237, 3903, 43.4, 138, 1227, 13.6]
    diffdock_gnina:                 [8993, 300, 7831, 87.1, 176, 1716, 19.1, 235, 3873, 43.1, 138, 1219, 13.6]
    equibind_unguided_raw:          [9090,  35,  263,  2.9,  19,  103,  1.1, 185, 2479, 27.3,   2,   21,  0.2]
    equibind_unguided_smina:        [9090, 236, 4664, 51.3,  64,  453,  5.0, 191, 2610, 28.7,  48,  249,  2.7]
    equibind_unguided_gnina:        [9088, 266, 5633, 62.0,  83,  498,  5.5, 200, 2661, 29.3,  55,  282,  3.1]
    equibind_fpocket_raw:           [9090,  13,   27,  0.3,   0,    0,  0.0, 180, 2449, 26.9,   0,    0,  0.0]
    equibind_p2rank_raw:            [8520,  12,   47,  0.6,   0,    0,  0.0, 181, 2336, 27.4,   0,    0,  0.0]

# -----------------------------------------------------------------------------
# Table 2 - PoseBusters Pass-All Recovery by Ranking Depth
# -----------------------------------------------------------------------------
# Recovery is the PoseBusters-valid, within-2 A gate applied at a ranking depth,
# using each tool's own order: AutoDock by optimized_rank on the gnina arm,
# DiffDock by rank on the smina variant, EquiBind by ascending gnina_affinity.
#
# The sidecar this reads did not exist on the canonical tree until 2026-09-02;
# it had only ever been written under the superseded whole-protein tree. It was
# regenerated here and reproduces every printed cell exactly.
table_2:
  source: "body_main_short.tex:336, tab:results-depth-recovery"
  input: posebusters_results/benchmark_matched_equibind/dock/pose_comparison_report_nearest/topk_recovery_validity_gnina_arm.csv
  columns: [rank1, top15, top30]
  rows:
    AutoDock: [111, 198, 199]
    DiffDock: [103, 167, 169]
    EquiBind: [55, 80, 80]
  note: >-
    Printed as percentages of 303 with the count in brackets: 36.6 (111),
    65.3 (198), 65.7 (199) for AutoDock. The counts are asserted, since the
    percentages are derived from them.

# -----------------------------------------------------------------------------
# Table 3 - Crystal-Cluster Reach and Co-Reach by Ranking Depth
# -----------------------------------------------------------------------------
# Added 2026-09-03. The whole table is carried verbatim in a companion stats file
# written beside the figure it accompanies, which is the house pattern: the PNG
# holds the picture and the sibling *_stats.txt holds the tested numbers. Parsing
# that file is therefore a real reproduction and not a re-derivation that might
# diverge from what the plotting run actually computed.
table_3:
  source: "body_main_short.tex, tab:results-cluster-recovery"
  input: posebusters_results/cluster_crystal_pocket_matched_equibind/autodock_mgltools_exh128_gnina__diffdock_smina_allposes_nearest/topN_crystal_cluster_matrix_stats.txt
  depths: [1, 5, 10, 15]
  reach_pct:                      # [rate, wilson_lo, wilson_hi] per depth
    AutoDock:  [[59, 53, 64], [79, 74, 83], [81, 76, 85], [83, 79, 87]]
    DiffDock:  [[54, 49, 60], [76, 70, 80], [79, 74, 83], [81, 76, 85]]
    EquiBind:  [[43, 37, 49], [46, 40, 51], [47, 41, 52], [47, 42, 53]]
  co_reach_phi:
    AutoDock+DiffDock: [+0.33, +0.23, +0.24, +0.23]
    AutoDock+EquiBind: [+0.45, +0.27, +0.29, +0.28]
    DiffDock+EquiBind: [+0.42, +0.30, +0.29, +0.26]
  all_three_observed: [89, 114, 121, 125]
  all_three_expected: [42, 82, 90, 96]
  note: >-
    Reach is the fraction of the 303 complexes with at least one top-N pose in
    the crystal-closest cluster. EquiBind is ranked by the gnina-affinity proxy,
    which the stats file states in its own header.

# -----------------------------------------------------------------------------
# Table 4 - Native-Interaction Recovery versus the Crystal by Pose Rank
# -----------------------------------------------------------------------------
# Added 2026-09-03. All sixty printed cells come straight from one CSV. The
# complex counts differ per tool and per rank because a complex contributes only
# where it has a PoseBusters-valid pose at that rank, so the three tools are
# compared on overlapping rather than identical cohorts. The table says so and
# the differing n row is the evidence, which is why n is asserted and not just
# the three rates.
table_4:
  source: "body_main_short.tex, tab:results-native-recovery-rank"
  input: pandamap_results/benchmark_matched_equibind_nearest/report/native_recovery_by_rank.csv
  ranks: [1, 2, 3, 4, 5]
  method_keys:
    AutoDock: autodock_mgltools_exh128_gnina
    DiffDock: diffdock_smina
    EquiBind: equibind_unguided_gnina
  rows:
    AutoDock:
      n:         [298, 298, 299, 296, 299]
      precision: [0.561, 0.550, 0.485, 0.497, 0.439]
      recall:    [0.572, 0.548, 0.477, 0.479, 0.414]
      f1:        [0.565, 0.546, 0.479, 0.485, 0.423]
    DiffDock:
      n:         [282, 267, 277, 270, 275]
      precision: [0.536, 0.529, 0.520, 0.497, 0.528]
      recall:    [0.526, 0.511, 0.496, 0.471, 0.504]
      f1:        [0.529, 0.517, 0.503, 0.479, 0.512]
    EquiBind:
      n:         [266, 256, 247, 245, 243]
      precision: [0.493, 0.489, 0.488, 0.476, 0.472]
      recall:    [0.459, 0.451, 0.450, 0.433, 0.423]
      f1:        [0.471, 0.465, 0.463, 0.449, 0.441]

# -----------------------------------------------------------------------------
# Table 10 - Pooled Cost per Generated Pose by Hardware Currency
# -----------------------------------------------------------------------------
# Added 2026-09-03. The charged column is not a stored field. It is
# cpu_core_s_per_generated / 32 + gpu_s_per_generated, the single basis the
# Results chapter uses throughout, and recomputing it here is what keeps the
# appendix table and the Results convention from drifting apart. The footnote's
# derived quantities are pinned alongside, because they are the numbers a reader
# checks the table against.
table_10:
  source: "body_appendix_short.tex, tab:appendix-cost-per-pose"
  input: posebusters_results/benchmark_matched_equibind/docking_effort_gnina_v2_charged_nearest/effort_summary.csv
  threads: 32
  rows:                           # [charged s, gpu s, cpu-core s] per generated pose
    autodock: [6.02, 4.12, 60.73]
    diffdock: [9.01, 8.99, 0.53]
    equibind: [0.34, 0.07, 8.47]
  footnote:
    autodock_poses_generated: 8976
    autodock_cpu_core_h: 151.42
    autodock_gpu_h: 10.27
    autodock_search_wall_h: 4.73      # cpu_core_h / 32
    autodock_charged_h: 15.00         # search_wall_h + gpu_h
    autodock_rescoring_share_pct: 68.5
    equibind_full_run_wall_h: 11.39   # all nine configurations

# -----------------------------------------------------------------------------
# Table 14 - Receptor Geometry Across the Four Frames
# -----------------------------------------------------------------------------
# Added 2026-09-03. This table had NO generator anywhere in the repository: no
# script wrote it and no stage produced it, so it was the one float in the
# document whose numbers existed only in the document. It is measured here
# directly from the four receptor PDBs, which are copy-only inputs.
#
# The measurement: distance of each diagnostic atom from the pore axis, averaged
# over the six subunits. The axis is the first principal component of the CA
# cloud and the origin is that cloud's centroid, which recovers all twenty
# printed cells. The six subunits live in SEGID rather than chain, the chain
# column having been flattened to a single value, so the six copies are found by
# residue number and atom name rather than by chain.
table_14:
  source: "body_appendix_short.tex, tab:appendix-frame-geometry"
  receptors:
    Fr0:   Data/Receptors/Orai1WT-START-Fr0.pdb
    Fr300: Data/Receptors/Orai1WT-MDSnap-Fr300.pdb
    Fr400: Data/Receptors/Orai1WT-MDSnap-Fr400.pdb
    Fr499: Data/Receptors/Orai1WT-MDSnap-Fr499.pdb
  subunits: 6
  rows:                           # [Fr0, Fr300, Fr400, Fr499] mean distance in angstrom
    "ARG 91 CZ":  [4.48, 4.82, 4.86, 4.72]
    "GLU 106 CD": [5.01, 5.83, 5.75, 5.76]
    "ASP 110 CG": [6.99, 10.50, 11.02, 10.95]
    "ASP 112 CG": [8.92, 14.08, 14.21, 14.19]
    "ASP 114 CG": [16.34, 19.26, 19.97, 20.22]
  prose:
    source: "the two paragraphs following the table"
    later_frame_spread_arg91: 0.14
    later_frame_spread_glu106: 0.08
    later_frame_spread_asp114: 0.96
    fr0_offset_aspartates: [3.5, 5.2]   # min and max over the three aspartates
    fr0_offset_gate_filter: [0.3, 0.8]  # min and max over Arg91 and Glu106

# -----------------------------------------------------------------------------
# Table 20 - Fixed-Rank Optimisation Gain by Pose-Rank Band
# -----------------------------------------------------------------------------
# Added 2026-09-03. Every pose is held at its own rank, so no re-ranking is
# involved and the gain is the change in the pose-count-weighted pooled rate
# within each band. The near-native gnina spans printed here are the same
# 0.1-0.7 and 4.1-4.6 ranges the Results chapter quotes for RQ2, so this table
# is what stands behind that sentence.
table_20:
  source: "body_appendix_short.tex, tab:appendix-refinement-bands"
  input: posebusters_results/benchmark_matched_equibind/dock/pose_comparison_report_nearest/optimization_benefit_by_rank.csv
  bands: {"1-10": [1, 10], "11-20": [11, 20], "21-30": [21, 30]}
  rows:                           # [1-10 smina, 1-10 gnina, 11-20 smina, 11-20 gnina, 21-30 smina, 21-30 gnina]
    "DiffDock/near-native":               [0.6, 0.7, 0.1, 0.1, 0.5, 0.4]
    "DiffDock/PoseBusters-valid":         [57, 59, 60, 62, 63, 67]
    "DiffDock/near-native and PB-valid":  [12.9, 13.0, 7.7, 7.6, 5.2, 5.2]
    "EquiBind/near-native":               [4.4, 4.6, 3.5, 4.4, 3.7, 4.1]
    "EquiBind/PoseBusters-valid":         [48, 58, 49, 59, 48, 60]
    "EquiBind/near-native and PB-valid":  [4.8, 5.0, 4.1, 5.0, 4.2, 4.7]
  columns: [near_%, pbv_%, both_%]
  note: >-
    The validity rows are printed to whole points and two of them sit close to a
    half: DiffDock 1-10 smina computes to 57.47 and EquiBind 21-30 smina to
    48.48, both of which round down as printed. Asserting against the printed
    integer with a 0.5 tolerance would accept either neighbour, so the check
    compares the unrounded value.

# -----------------------------------------------------------------------------
# Table 22 - Accurate-but-Invalid Share by Ranking Depth
# -----------------------------------------------------------------------------
# Added 2026-09-03. This is the complex-level gap between the two columns of
# Table 18, but it CANNOT be checked by subtracting the printed cells of that
# table: subtracting two values already rounded to one decimal moves three of
# the twenty entries by a tenth. It is computed from counts over the 303, which
# is also how the thesis derived it.
table_22:
  source: "body_appendix_short.tex, tab:appendix-accurate-invalid"
  # Read from the same sidecar Table 18 uses, which carries near_k and valid_k as
  # counts. Variant labels are that file's own, so they read as the thesis prints
  # them rather than as internal method keys.
  input: posebusters_results/benchmark_matched_equibind/dock/pose_comparison_report_nearest/topk_recovery_validity.csv
  footnote_variant: "AutoDock Vina"
  # The table prints the Results chapter's names for the arms; the sidecar uses
  # the recovery chapter's. Only one of the six actually differs, and mapping it
  # here keeps the printed name in the assertion output.
  variant_labels:
    "AutoDock Vina + gnina": "AutoDock (gnina-opt)"
  n: 303
  depths: [1, 5, 10, 15]
  rows:                           # [share %, wilson_lo, wilson_hi] per depth
    "AutoDock Vina + gnina": [[0.7, 0.2, 2.4], [1.3, 0.5, 3.3], [1.0, 0.3, 2.9], [1.0, 0.3, 2.9]]
    "DiffDock (raw)":        [[15.5, 11.9, 20.0], [19.1, 15.1, 23.9], [19.5, 15.4, 24.3], [18.8, 14.8, 23.6]]
    "DiffDock (gnina-opt)":  [[1.3, 0.5, 3.3], [1.0, 0.3, 2.9], [1.0, 0.3, 2.9], [1.0, 0.3, 2.9]]
    "EquiBind (raw)":        [[0.7, 0.2, 2.4], [2.3, 1.1, 4.7], [3.3, 1.8, 6.0], [5.3, 3.3, 8.4]]
    "EquiBind (gnina-opt)":  [[0.7, 0.2, 2.4], [1.0, 0.3, 2.9], [1.0, 0.3, 2.9], [1.0, 0.3, 2.9]]
  # The raw AutoDock arm is named in the table's footnote rather than given a row.
  footnote_autodock_raw:     [[0.3, 0.1, 1.8], [0.3, 0.1, 1.8], [0.0, 0.0, 1.3], [0.0, 0.0, 1.3]]

# -----------------------------------------------------------------------------
# Table 25 - Decomposition of the Rank-1 to Best-of-Top-15 Pass-All Gain
# -----------------------------------------------------------------------------
# Added 2026-09-03. Four rows that have to add up, and the check is that they do
# so from the pose table rather than on paper. Writing N for the near-native set
# and V for the validity-aware one, at depths 1 and 15:
#   gained        |N15 \ N1|
#   stay_invalid  |(N15 \ N1) \ V15|      complexes that gain a pose which never passes
#   rescued       |(N1 & V15) \ V1|       already near-native at rank-1, valid only deeper
#   net           |V15| - |V1|             and net == gained - stay_invalid + rescued
# The pools are nested, so V1 is a subset of V15 and no complex is ever lost.
table_25:
  source: "body_appendix_short.tex, tab:results-depth-gain"
  input: posebusters_results/benchmark_matched_equibind/dock/pose_comparison_report_nearest/per_pose_metrics.csv
  arms:
    "AutoDock Vina + gnina": [autodock_mgltools_exh128_gnina, optimized_rank]
    "DiffDock + smina":      [diffdock_smina, rank]
    "EquiBind + gnina":      [equibind_unguided_gnina, rank]
  rows:                           # [gained, stay_invalid, rescued, net]
    "AutoDock Vina + gnina": [88, 2, 1, 87]
    "DiffDock + smina":      [63, 1, 2, 64]
    "EquiBind + gnina":      [26, 2, 1, 25]

# -----------------------------------------------------------------------------
# Table 26 - Near-Nativeness and Form Recovery at Different Ranking Depths
# -----------------------------------------------------------------------------
# Added 2026-09-03. 180 cells, and the largest float in the document. Both halves
# are validity-aware: the gate is pb_valid AND distance <= t, which is why the 2 A
# in-place column reproduces Table 2 exactly at all three depths and the 1 A
# Kabsch column is the form endpoint the Results quote. Reading it as an
# unconditioned distance gate would move almost every cell.
#
# The in-place metric is `rmsd` and the Kabsch metric is `bestfit_rmsd`. Depths
# use each tool's own order, EquiBind by gnina affinity.
table_26:
  source: "body_appendix_short.tex, tab:results-near-native-form"
  input: posebusters_results/benchmark_matched_equibind/dock/pose_comparison_report_nearest/per_pose_metrics.csv
  n: 303
  thresholds: [0.25, 0.5, 0.75, 1, 1.25, 1.5, 1.75, 2, 2.25, 2.5]
  depths: [1, 15, 30]
  arms:
    "AutoDock Vina + gnina": [autodock_mgltools_exh128_gnina, optimized_rank]
    "DiffDock + smina":      [diffdock_smina, rank]
    "EquiBind + gnina":      [equibind_unguided_gnina, rank]
  metrics:
    RMSD: rmsd
    "Kabsch RMSD": bestfit_rmsd
  rows:
    RMSD:
      "AutoDock Vina + gnina":
        1:  [0.0, 5.9, 13.5, 22.1, 27.1, 30.4, 32.7, 36.6, 37.0, 38.9]
        15: [0.0, 11.2, 20.1, 34.7, 45.5, 52.1, 59.4, 65.3, 67.0, 69.6]
        30: [0.0, 11.2, 20.1, 34.7, 45.9, 52.8, 60.1, 65.7, 67.7, 70.6]
      "DiffDock + smina":
        1:  [0.3, 4.0, 10.9, 15.5, 21.5, 26.1, 31.4, 34.0, 35.3, 37.6]
        15: [1.0, 9.6, 20.5, 30.0, 40.6, 46.5, 51.8, 55.1, 58.1, 60.1]
        30: [1.0, 10.9, 21.8, 31.7, 41.6, 48.2, 53.1, 55.8, 59.4, 61.7]
      "EquiBind + gnina":
        1:  [0.0, 1.3, 4.0, 6.9, 9.6, 12.5, 15.5, 18.2, 19.5, 20.5]
        15: [0.3, 3.0, 6.3, 10.2, 14.2, 17.8, 22.1, 26.4, 27.7, 29.4]
        30: [0.3, 3.0, 6.6, 10.6, 14.2, 17.8, 22.4, 26.4, 27.7, 29.4]
    "Kabsch RMSD":
      "AutoDock Vina + gnina":
        1:  [10.2, 25.7, 41.6, 52.5, 61.1, 66.7, 74.6, 78.9, 81.5, 84.8]
        15: [17.8, 35.3, 55.8, 71.9, 81.2, 87.1, 91.4, 93.4, 96.0, 97.4]
        30: [18.8, 37.0, 58.7, 74.3, 82.8, 88.4, 92.7, 95.4, 97.7, 97.7]
      "DiffDock + smina":
        1:  [11.9, 25.1, 38.6, 52.1, 61.7, 70.0, 76.2, 82.5, 85.8, 88.1]
        15: [21.1, 39.3, 57.4, 72.3, 80.2, 87.8, 94.1, 95.7, 96.0, 96.4]
        30: [22.4, 42.6, 60.4, 74.6, 84.5, 92.7, 96.0, 97.0, 97.7, 98.0]
      "EquiBind + gnina":
        1:  [5.6, 15.5, 21.8, 33.3, 42.9, 48.5, 53.1, 61.4, 66.3, 71.0]
        15: [15.2, 27.7, 40.3, 51.2, 62.0, 71.0, 75.9, 79.9, 82.5, 85.1]
        30: [17.2, 31.0, 43.9, 54.1, 64.4, 72.6, 77.6, 81.8, 83.5, 85.5]
  cross_check:
    note: >-
      The 2 A in-place column must equal Table 2's counts over 303 at the two
      shared depths. Asserted, because it is the one place the two tables can
      drift apart without either looking wrong on its own.
    table_2_depths: [1, 15]

# -----------------------------------------------------------------------------
# Table 27 - In-Place-RMSD-versus-Form Distributions by Tool and Ranking Depth
# -----------------------------------------------------------------------------
# Added 2026-09-03. Read from the filmstrip sidecar whose name carries the three
# depths it was built at. The sibling filmstrip_stats__per_tool_depth.csv looks
# interchangeable and is NOT: it holds depths 1, 3 and 5, so it silently supplies
# no top-15 row and its depth-3 rows would line up against the table's top-5.
table_27:
  source: "body_appendix_short.tex, tab:results-placement-form"
  input: posebusters_results/benchmark_matched_equibind/dock/pose_comparison_report_nearest/20d_form_vs_placement_by_family__depth_filmstrip_pbvalid__rank1_top5_top15__stats_per_tool_depth.csv
  columns: [n_poses, n_valid_complexes, coverage_pct, inplace_median, inplace_q1,
            inplace_q3, form_median, form_q1, form_q3, median_r,
            pct_placement_limited, pct_mixed, pct_form_limited]
  rows:
    "AutoDock/1":  [190, 190, 62.7, 1.490, 0.758, 4.220, 0.845, 0.426, 1.507, 0.365, 47.9, 25.3, 26.8]
    "AutoDock/5":  [882, 256, 84.5, 3.476, 1.791, 6.035, 1.265, 0.704, 1.984, 0.172, 65.1, 19.4, 15.5]
    "AutoDock/15": [2200, 275, 90.8, 5.043, 2.937, 7.414, 1.445, 0.811, 2.200, 0.094, 77.8, 13.9, 8.3]
    "DiffDock/1":  [164, 164, 54.1, 1.467, 0.753, 3.068, 0.885, 0.488, 1.427, 0.458, 40.9, 28.7, 30.5]
    "DiffDock/5":  [790, 235, 77.6, 1.646, 0.863, 4.000, 0.882, 0.498, 1.469, 0.406, 44.2, 32.5, 23.3]
    "DiffDock/15": [2139, 259, 85.5, 1.929, 0.921, 4.893, 0.918, 0.517, 1.569, 0.363, 47.9, 30.8, 21.3]
    "EquiBind/1":  [143, 143, 47.2, 2.977, 1.347, 5.476, 1.120, 0.592, 2.008, 0.214, 59.4, 23.8, 16.8]
    "EquiBind/5":  [673, 156, 51.5, 3.640, 1.770, 6.191, 1.260, 0.752, 2.018, 0.154, 64.3, 20.8, 14.9]
    "EquiBind/15": [1830, 156, 51.5, 4.065, 2.334, 6.453, 1.342, 0.789, 2.118, 0.133, 70.2, 18.5, 11.3]

# -----------------------------------------------------------------------------
# Table 9 - Docking-Protocol Parameters, Calibration Benchmark
# -----------------------------------------------------------------------------
# Added 2026-09-03. Most of this table is prose and not checkable, but the settings
# that define the runs are all in the committed configs, and they are exactly the
# kind of value that drifts: a config edited for one arm and an appendix left
# describing the old one is invisible until someone re-reads both.
#
# The EquiBind pose budget is bounded by len(rdkit_seeds) x conformers_per_seed,
# so the seed list length is asserted rather than the comment that states 30.
# uff_minimize is included because the appendix says the in-protein relaxation is
# implemented but switched off, and a silent flip to true is the single change
# that would invalidate the reported EquiBind arm.
table_9:
  source: "body_appendix_short.tex, tab:appendix-protocols"
  config_dir: Scripts/Docking/configs_thesis
  autodock:
    config: 02_benchmark_autodock_exh128_gnina.yaml
    exhaustiveness: 128
    num_modes: 30
    energy_range: 6
    seed: 42
  ladder:                         # "Exhaustiveness ladder 18 / 32 / 64 / 92 / 128"
    10_ladder_exh18.yaml: 18
    11_ladder_exh32_raw.yaml: 32
    13_ladder_exh64_raw.yaml: 64
    15_ladder_exh92.yaml: 92
    02_benchmark_autodock_exh128_gnina.yaml: 128
  diffdock:
    config: 03_benchmark_diffdock.yaml
    num_samples: 30
    inference_steps: 20
  equibind:
    config: 04_benchmark_equibind.yaml
    n_unguided_poses: 30
    n_rdkit_seeds: 30             # the real bound on the pose budget
    conformers_per_seed: 1
    uff_minimize: false
  note: >-
    The "Total poses (303 pairs)" row of this table prints 8,976 for the reported
    AutoDock arm, 9,013 raw and 8,993 refined for DiffDock and 9,090 for EquiBind.
    Those four are the produced-pose column of Table 1 and are asserted there.

# -----------------------------------------------------------------------------
# Table 11 - Docking-Protocol Parameters, Orai1 Panels, and its accounting prose
# -----------------------------------------------------------------------------
# Added 2026-09-03. The settings come from the two Orai config sets; the pose and
# unit accounting comes from the control panel's own PoseBusters table.
#
# That accounting is the part worth asserting. The two panels were sampled at
# different budgets, thirty against ten, and the appendix spends a page bounding
# what that asymmetry does to the comparison. Every number in that argument was
# unasserted, including the 12,315 control poses the top-ten-cap analysis rests
# on and which the appendix quotes again in Appendix C.
#
# ARM KEYS. The control PoseBusters table names the ENGINE in docking_method and
# carries exactly one arm per engine, so the three are (autodock, gnina),
# (diffdock, smina) and (equibind_guided, unguided/gnina). Do not expect the
# composed variant keys used on the benchmark tree; they are not in this file.
table_11:
  source: "body_appendix_short.tex, tab:appendix-orai-protocols and the two paragraphs after it"
  config_dir: Scripts/Docking/configs_thesis
  control_pb: posebusters_results/_orai_matched_root/orai_benchmark/dock/posebusters_filtered_results.csv
  configs:
    experimental_autodock:
      config: 20_orai_jku_autodock_exh128_gnina.yaml
      exhaustiveness: 128
      num_modes: 30
      energy_range: 6
      seed: 42
    control_autodock:
      config: 30_orai_benchmark_autodock_exh128_gnina.yaml
      exhaustiveness: 128
      num_modes: 10
      energy_range: 6
      seed: 42
    experimental_diffdock:
      config: 21_orai_jku_diffdock.yaml
      num_samples: 30
      inference_steps: 20
    control_diffdock:
      config: 31_orai_benchmark_diffdock.yaml
      num_samples: 10
      inference_steps: 20
    control_equibind:
      config: 32_orai_benchmark_equibind.yaml
      n_unguided_poses: 10
      uff_minimize: false
  arms:                           # [docking_method, optimizer, pocket_source or null]
    autodock: [autodock, gnina, null]
    diffdock: [diffdock, smina, null]
    equibind: [equibind_guided, null, unguided]
  control_units:
    autodock: 1232
    diffdock: 1215
    equibind: 1232
  control_poses:
    autodock: 12315
    diffdock: 11673
    equibind: 12320
  diffdock_gap:
    units_missing: 17
    by_frame:
      Orai1WT-MDSnap-Fr300: 6
      Orai1WT-MDSnap-Fr400: 5
      Orai1WT-MDSnap-Fr499: 5
      Orai1WT-START-Fr0: 1
    units_full_ten: 1037
    units_under_ten: 178
    units_with_nine: 89
    units_with_one: 10

# -----------------------------------------------------------------------------
# Table 12 - Interaction-Type Mean Counts per Pose on Orai1
# -----------------------------------------------------------------------------
# Added 2026-09-03 as an EXPECTED FAILURE, and repaired the same day. This block
# is history now; the check is expected to PASS.
#
# What was wrong: the printed AutoDock column was the PRE_FR0 generation. Eighteen
# of the thirty-five cells differed from the canonical 2026-09-01 run and every one
# of them was an AutoDock cell, because the DiffDock block is bit-identical across
# all four generations on disk. That is what made it invisible: any spot check that
# landed on a DiffDock number agreed perfectly.
#
#                        printed   canonical (09-01)   plain (08-30)   PRE_FR0
#   AD hydrogen bond      3.85           4.15              3.97          3.85
#   AD experimental       2.42           2.53              2.53          2.42
#   AD Cliff's delta     +0.42          +0.45             +0.40         +0.42
#
# CORRECTION to what this block originally asserted. It claimed the AutoDock column
# "does not reproduce from any artifact in the repository" and that "no arm on disk
# could produce 3.85". Both are false. All twenty-one printed AutoDock cells
# reproduce character-for-character from
#   obsolete/pandamap_results/orai_interaction_compare_PRE_FR0/
#       orai_pandamap_interaction_compare_stats.txt
# and a second file generated by a different script carries the same values,
#   obsolete/posebusters_results/orai_pbvalid_tm_share_compare_PRE_FR0/
#       orai_ligand_level_contrasts.txt
# The original search looked in pandamap_results/ but not in obsolete/. The table was
# two generations stale, not unattributable.
#
# Two rows were ADDED in the repair. Canonically AutoDock clears BH on carbon-pi and
# pi-pi stacking, neither of which was printed, so the footnote's claim that every
# clearing cell appears in the table was false. The fourteen clearing cells span
# exactly the nine interaction types now listed.
#
# The aggregation was never the explanation. The caption says per-complex mean counts
# per pose, _per_complex_means computes exactly that, and the stats file's "mean/pose"
# line is the mean of those per-complex means, so table and stats file share a basis.
table_12:
  source: "body_appendix_short.tex, tab:appendix-orai-interaction"
  input: pandamap_results/orai_interaction_compare_matched/orai_pandamap_interaction_compare_stats.txt
  # The footnote's counts and ligand-unit minima come from the contrasts sidecar, not
  # the stats file. The stats file writes "<1e-4" for the strongest cells, which no
  # numeric parse can rank, and it carries no ligand-unit collapse at all.
  footnote_input: posebusters_results/_orai_matched_root/orai_pbvalid_tm_share_compare/orai_ligand_level_contrasts.csv
  # Regenerated 2026-09-03 onto the canonical 2026-09-01 compare run. The printed
  # AutoDock column had been the PRE_FR0 generation, reproducible only from
  # obsolete/pandamap_results/orai_interaction_compare_PRE_FR0/. Two rows were ADDED
  # at the same time: canonically AutoDock clears BH on carbon-pi and pi-pi stacking,
  # and the footnote asserts every clearing cell appears in the table, which was false
  # while those two rows were absent. The fourteen clearing cells span exactly the
  # nine types now printed.
  tools: {AD: "AutoDock Vina", DD: "DiffDock"}
  rows:                           # [AD bench, AD exp, AD delta, DD bench, DD exp]
    "Hydrogen bonds":   [4.15, 2.53, 0.45, 2.47, 1.31]
    "Halogen bonds":    [0.19, 1.26, -0.52, 0.16, 1.17]
    "Hydrophobic":      [3.75, 5.95, -0.59, 2.36, 3.42]
    "Alkyl-pi":         [4.90, 6.67, -0.42, 3.31, 5.06]
    "Carbon-pi":        [2.55, 3.55, -0.50, 1.40, 1.47]
    "pi-pi stacking":   [2.39, 3.17, -0.41, 1.29, 1.19]
    "Amide-pi":         [0.92, 0.95, -0.04, 0.56, 0.89]
    "Charged classes":  [0.47, 0.00, 0.38, 0.22, 0.00]
    "Repulsion":        [0.43, 0.00, 0.31, 0.37, 0.00]
  stats_labels:                   # how each row is named in the stats file
    "Hydrogen bonds": "Hydrogen bonds"
    "Halogen bonds": "Halogen bonds"
    "Hydrophobic": "Hydrophobic"
    "Alkyl-pi": "Alkyl"
    "Carbon-pi": "Carbon"
    # full label: the regex appends \S* then expects whitespace before "mean/pose",
    # so a label ending mid-word ("π–π" before " stacking") would not match.
    "pi-pi stacking": "π–π stacking"
    "Amide-pi": "Amide"
    "Charged classes": "Charged classes"
    "Repulsion": "Repulsion"
  # Asserted by check_table_12 as of 2026-09-03. Before that this block sat in the
  # spec unread, which is why the footnote's stale "eleven" and 0.142 survived every
  # harness run while the row cells were failing loudly.
  footnote:
    cells_clearing_bh: 14         # 8 AutoDock + 6 DiffDock at the frame-ligand unit
    smallest_adjusted_autodock: 0.089
    smallest_adjusted_diffdock: 0.106
    both_tools_clear: 5           # hydrogen bonds, halogen, hydrophobic, alkyl-pi, repulsion
    total_cells: 26               # 13 interaction types x the 2 mature tools
    none_clears_at_ligand_unit: true

# -----------------------------------------------------------------------------
# Table 16 - Distribution of Principal Ligand Descriptors in the Benchmark
# -----------------------------------------------------------------------------
# Added 2026-09-03. Straight from the dataset notebook's summary table, on all
# 308 prepared ligands rather than the 303 analysed: this describes the library
# that was docked, not the cohort that survived to the three-tool comparison.
# Descriptors are computed on a hydrogen-suppressed molecule.
table_16:
  source: "body_appendix_short.tex, tab:appendix-ligand-distribution"
  input: PoseBusters_Benchmark_Analysis/summary_statistics.csv
  n: 308
  rows:                           # key: [median, q1, q3, min, max]
    heavy_atoms: [24, 16, 32, 6, 64]
    mw:          [359, 236, 462, 100, 872]
    rot_bonds:   [5, 2, 7, 0, 20]
    hba:         [6, 3, 9, 0, 21]
    hbd:         [3, 2, 5, 0, 13]
    tpsa:        [107, 66, 160, 0, 384]
    logp:        [0.9, -1.6, 3.2, -8.4, 14.0]
    fsp3:        [0.41, 0.23, 0.57, 0.00, 1.00]
    qed:         [0.43, 0.29, 0.60, 0.04, 0.91]
    n_rings:     [3, 1, 4, 0, 8]
  decimals:                       # printed places, per row
    heavy_atoms: 0
    mw: 0
    rot_bonds: 0
    hba: 0
    hbd: 0
    tpsa: 0
    logp: 1
    fsp3: 2
    qed: 2
    n_rings: 0

# -----------------------------------------------------------------------------
# Table 24 - PoseBusters Failure Decomposition by Check Group, All Eight Variants
# -----------------------------------------------------------------------------
# Added 2026-09-03. Ninety-six cells across the two halves.
#
# THE JOIN. The PoseBusters table's `docking_method` is the ENGINE, not the
# variant: autodock_mgltools_exh128 holds 17,952 rows because the raw and the
# gnina-rescored arm share it, and the optimiser lives in a separate column.
# Joining on it silently pools the two arms and the poses column reads double.
# The join key here is `pose_file`, which is unique in both tables and carries
# the variant implicitly, so no composition of engine, optimiser and pocket
# source has to be reconstructed and got right.
#
# The three group shares can sum past the invalid share because one pose may fail
# in more than one group. Min. dist. protein is a single check inside the
# intermolecular group and is reported separately as the dominant contributor.
table_24:
  source: "body_appendix_short.tex, tab:appendix-pb-decomposition-full"
  pb_input: posebusters_results/benchmark_matched_equibind/dock/posebusters_filtered_results.csv
  metrics_input: posebusters_results/benchmark_matched_equibind/dock/pose_comparison_report_nearest/per_pose_metrics.csv
  join_on: pose_file
  near_native_rmsd: 2.0
  groups:
    chemical: [mol_pred_loaded, mol_cond_loaded, sanitization, inchi_convertible,
               all_atoms_connected, no_radicals]
    intramolecular: [bond_lengths, bond_angles, aromatic_ring_flatness,
                     "non-aromatic_ring_non-flatness", double_bond_flatness,
                     internal_steric_clash, internal_energy]
    intermolecular: ["protein-ligand_maximum_distance", minimum_distance_to_protein,
                     minimum_distance_to_organic_cofactors,
                     minimum_distance_to_inorganic_cofactors, minimum_distance_to_waters,
                     volume_overlap_with_protein, volume_overlap_with_organic_cofactors,
                     volume_overlap_with_inorganic_cofactors, volume_overlap_with_waters]
  single_check: minimum_distance_to_protein
  n_applied_checks: 22
  arms:
    "AutoDock (raw)":    autodock_mgltools_exh128
    "AutoDock + gnina":  autodock_mgltools_exh128_gnina
    "DiffDock (raw)":    diffdock
    "DiffDock + smina":  diffdock_smina
    "DiffDock + gnina":  diffdock_gnina
    "EquiBind (raw)":    equibind_unguided_raw
    "EquiBind + smina":  equibind_unguided_smina
    "EquiBind + gnina":  equibind_unguided_gnina
  all_poses:                      # [poses, valid%, chem%, intra%, inter%, mindist%]
    "AutoDock (raw)":   [8976, 99.6, 0.0, 0.1, 0.2, 0.2]
    "AutoDock + gnina": [8976, 98.9, 0.0, 0.9, 0.2, 0.2]
    "DiffDock (raw)":   [9013, 24.4, 0.0, 3.8, 75.2, 73.8]
    "DiffDock + smina": [8993, 84.5, 0.0, 1.5, 14.6, 13.4]
    "DiffDock + gnina": [8993, 87.1, 0.0, 1.4, 12.0, 10.7]
    "EquiBind (raw)":   [9090, 2.9, 0.0, 27.9, 96.8, 96.5]
    "EquiBind + smina": [9090, 51.3, 0.0, 4.8, 47.6, 47.3]
    "EquiBind + gnina": [9088, 62.0, 0.0, 3.7, 37.0, 36.6]
  near_native:
    "AutoDock (raw)":   [307, 98.4, 0.0, 0.0, 1.6, 1.6]
    "AutoDock + gnina": [319, 97.5, 0.0, 0.9, 1.6, 1.6]
    "DiffDock (raw)":   [1683, 50.3, 0.0, 2.2, 48.2, 48.2]
    "DiffDock + smina": [1715, 94.6, 0.0, 0.1, 5.4, 5.4]
    "DiffDock + gnina": [1716, 94.5, 0.0, 0.2, 5.3, 5.2]
    "EquiBind (raw)":   [103, 20.4, 0.0, 10.7, 78.6, 78.6]
    "EquiBind + smina": [453, 91.6, 0.0, 0.2, 8.2, 8.2]
    "EquiBind + gnina": [498, 93.6, 0.0, 0.2, 6.2, 6.2]
  note: >-
    The poses and valid-% columns must equal Table 1's produced-pose and
    PoseBusters-% columns, and the near-native counts must equal Table 1's
    near-native pose counts. Both joins are asserted, because they are what makes
    this table a decomposition of that one rather than a separate measurement.

# -----------------------------------------------------------------------------
# Table 21 - Cross-Tool Comparisons of Near-Native Recovery
# -----------------------------------------------------------------------------
# ADDED 2026-09-03, after this table was found to be the one appendix float the
# harness did not cover. Appendix C declares the cross-tool family is "computed on
# the gnina-rescored AutoDock Vina arm", and Table 21 prints that arm's rates, but
# _TOPK_TEST_PAIRS carried raw Vina in every commit of its history. The script
# therefore tested a contrast the thesis never reported: 31.4 against DiffDock's
# 33.7 instead of the printed 37.3, turning "significant at every deeper pool"
# into ns at three of four depths. Nothing caught it because no assertion read
# this table. The baseline is now pinned here as well as in the script.
#
# Columns per depth: [baseline %, comparison %, baseline-only wins,
# comparison-only wins, Holm p]. Depths [1, 5, 10, 15].
table_21:
  source: "body_appendix_short.tex, tab:appendix-cross-tool-mcnemar"
  input: posebusters_results/benchmark_matched_equibind/dock/pose_comparison_report_nearest/topk_recovery_stats.csv
  family: between_tool
  family_size: 16
  depths: [1, 5, 10, 15]
  rows:
    "AutoDock (gnina-opt) -> DiffDock (raw)": [[37.3, 33.7, 62, 51, 0.6938], [62.0, 44.6, 100, 47, 0.0001176], [65.0, 48.2, 99, 48, 0.0002199], [66.3, 49.8, 99, 49, 0.0002897]]
    "AutoDock (gnina-opt) -> DiffDock (gnina-opt)": [[37.3, 35.6, 60, 55, 0.7093], [62.0, 49.2, 89, 50, 0.00594], [65.0, 52.8, 87, 50, 0.007955], [66.3, 56.1, 83, 52, 0.02869]]
    "DiffDock (gnina-opt) -> EquiBind (gnina-opt)": [[35.6, 18.8, 68, 17, 1.958e-07], [49.2, 25.1, 94, 21, 3.564e-11], [52.8, 27.4, 98, 21, 5.284e-12], [56.1, 27.4, 104, 17, 2.572e-15]]
    "AutoDock (gnina-opt) -> EquiBind (gnina-opt)": [[37.3, 18.8, 75, 19, 4.818e-08], [62.0, 25.1, 128, 16, 9.847e-22], [65.0, 27.4, 129, 15, 1.296e-22], [66.3, 27.4, 132, 14, 4.827e-24]]

# -----------------------------------------------------------------------------
# Table 17 - Physicochemical Descriptors of the Experimental Orai1 Ligands
# -----------------------------------------------------------------------------
# Added 2026-09-03. Recomputed with RDKit from the three geometry-optimised SDFs.
#
# TWO TRAPS, both already documented in comments beside the table in the .tex and
# both re-encoded here so the harness enforces what those comments assert.
#
# 1. THE GSK FILE. The row describes the NEUTRAL species and its source must be
#    gsk7975a-deprot-as-neutral-OPT.sdf. The sibling gsk7975a-deprot-OPT.sdf is
#    the -1 phenolate, a DIFFERENT species: C18H11F5N3O2-, 396.3 Da, 1 HBD,
#    TPSA 70.0. Reading it would change four printed cells and look plausible.
# 2. THE HYDROGEN BASIS. Rotatable bonds must be counted on a hydrogen-SUPPRESSED
#    molecule. On the H-explicit basis the three read 6, 7 and 5 instead of 5, 5
#    and 4, because the terminal C-NH2, phenol C-OH and methoxy O-CH3 bonds are
#    then counted. Every other descriptor is identical on both bases.
#
# ROUNDING. 2abp-NH2's TPSA is exactly 35.25 and the table prints 35.3, i.e. half
# up. Comparison is therefore against the unrounded value with a half-ulp window,
# not against a re-rounded one, which would take the exact half the other way.
table_17:
  source: "body_appendix_short.tex, tab:appendix-orai-descriptors"
  remove_hs: true
  ligands:
    "2abp-NH2":
      input: Data/Ligands/JKU/pdbqt/2abp-nh2-OPT.sdf
      formula: C14H16BNO
      mw: 225.1
      heavy_atoms: 17
      rot_bonds: 5
      arom_rings: 2
      hbd: 1
      hba: 2
      tpsa: 35.3
      clogp: 0.77
      ro5_violations: 0
    "Synta-66":
      input: Data/Ligands/JKU/pdbqt/Synta-66-OPT-Singlet.sdf
      formula: C20H17FN2O3
      mw: 352.4
      heavy_atoms: 26
      rot_bonds: 5
      arom_rings: 3
      hbd: 1
      hba: 4
      tpsa: 60.5
      clogp: 4.16
      ro5_violations: 0
    "GSK-7975A (neutral)":
      input: Data/Ligands/JKU/pdbqt/gsk7975a-deprot-as-neutral-OPT.sdf
      formula: C18H12F5N3O2
      mw: 397.3
      heavy_atoms: 28
      rot_bonds: 4
      arom_rings: 3
      hbd: 2
      hba: 4
      tpsa: 67.2
      clogp: 4.19
      ro5_violations: 0
  wrong_gsk_file:
    path: Data/Ligands/JKU/pdbqt/gsk7975a-deprot-OPT.sdf
    formula: C18H11F5N3O2-
    note: >-
      Asserted to be a DIFFERENT species, so that the two files can never be
      silently swapped. If this ever matches the neutral formula, the source tree
      has changed and the provenance note beside the table is no longer true.

# -----------------------------------------------------------------------------
# Table 18 - Top-k Recovery with Wilson 95% Confidence Intervals
# -----------------------------------------------------------------------------
# Extended 2026-09-02 with AutoDock Vina (raw) and DiffDock + smina. The table
# previously showed a raw-and-optimised pair for the two deep-learning tools and
# only the optimised arm for the physics one, and omitted the DiffDock refiner the
# Results chapter actually carries forward. Both were already in the source CSV.
#
# Columns per depth: [near-native %, validity-aware %]. Depths [1, 5, 10, 15].
table_18:
  source: "body_appendix_short.tex, tab:appendix-top-k-recovery"
  input: posebusters_results/benchmark_matched_equibind/dock/pose_comparison_report_nearest/topk_recovery_validity.csv
  depths: [1, 5, 10, 15]
  rows:
    "AutoDock Vina": [[31.4, 31.0], [50.8, 50.5], [58.7, 58.7], [61.1, 61.1]]
    "AutoDock (gnina-opt)": [[37.3, 36.6], [62.0, 60.7], [65.0, 64.0], [66.3, 65.3]]
    "DiffDock (raw)": [[33.7, 18.2], [44.6, 25.4], [48.2, 28.7], [49.8, 31.0]]
    "DiffDock + smina": [[35.3, 34.0], [48.8, 47.5], [53.5, 52.5], [56.1, 55.1]]
    "DiffDock (gnina-opt)": [[35.6, 34.3], [49.2, 48.2], [52.8, 51.8], [56.1, 55.1]]
    "EquiBind (raw)": [[1.3, 0.7], [3.0, 0.7], [4.0, 0.7], [5.9, 0.7]]
    "EquiBind (gnina-opt)": [[18.8, 18.2], [25.1, 24.1], [27.4, 26.4], [27.4, 26.4]]

# -----------------------------------------------------------------------------
# Table 19 - Within-Tool Optimisation Effect on Cumulative Top-k Recovery
# -----------------------------------------------------------------------------
# Extended 2026-09-02 with the AutoDock rescoring contrast and the DiffDock smina
# one. The Holm correction was also split: these four within-tool contrasts form
# their own family of 16, separate from the between-tool family, because pooling
# them let one tool's optimisation row change every cross-tool verdict.
#
# Columns per depth: [raw %, optimised %, raw-only wins, opt-only wins].
table_19:
  source: "body_appendix_short.tex, tab:appendix-refinement-mcnemar"
  input: posebusters_results/benchmark_matched_equibind/dock/pose_comparison_report_nearest/topk_recovery_stats.csv
  family: within_tool
  family_size: 16
  depths: [1, 5, 10, 15]
  rows:
    "AutoDock Vina -> AutoDock (gnina-opt)": [[31.4, 37.3, 21, 39], [50.8, 62.0, 3, 37], [58.7, 65.0, 3, 22], [61.1, 66.3, 1, 17]]
    "DiffDock (raw) -> DiffDock + smina": [[33.7, 35.3, 1, 6], [44.6, 48.8, 5, 18], [48.2, 53.5, 5, 21], [49.8, 56.1, 5, 24]]
    "DiffDock (raw) -> DiffDock (gnina-opt)": [[33.7, 35.6, 2, 8], [44.6, 49.2, 5, 19], [48.2, 52.8, 6, 20], [49.8, 56.1, 6, 25]]
    "EquiBind (raw) -> EquiBind (gnina-opt)": [[1.3, 18.8, 2, 55], [3.0, 25.1, 2, 69], [4.0, 27.4, 1, 72], [5.9, 27.4, 1, 66]]

# -----------------------------------------------------------------------------
# Table 5 - Physical-Validity and Operational-Placement Yield, Orai1
# -----------------------------------------------------------------------------
# Usable = PoseBusters-valid AND outside the transmembrane pore slab, over the
# top ten ranked poses of each frame-ligand unit in each tool's own order.
table_5:
  source: "body_main_short.tex, tab:results-orai-yield"
  input: posebusters_results/_orai_matched_root/orai_pbvalid_tm_share_compare/pbvalid_tm_share_pooled.csv
  columns: [poses, pb_valid, pb_valid_pct, usable, usable_pct]
  experimental_totals:
    AutoDock: [120, 120, 100.0, 65, 54.2]
    DiffDock: [120, 112,  93.3, 82, 68.3]
    EquiBind: [120, 107,  89.2,  1,  0.8]
  note: >-
    The pooled base is 120 poses per tool, not the per-unit tally. Appendix B
    records that restricting the experimental panel to the first ten Vina modes,
    which is the control panel's selection rule, raises AutoDock's usable yield
    from 54.2 to 65.8 per cent pooled.

# -----------------------------------------------------------------------------
# Table 6 - Cost per Qualifying Pose (charged basis)
# -----------------------------------------------------------------------------
# A qualifying pose is PoseBusters-valid and within 2 A. The charged basis is
# cpu_core_s / 32 + gpu_s, applied uniformly. The default elapsed basis divides
# wall_s, which is not one quantity across arms and moves with the optimiser
# worker count; the charged basis does not.
table_6:
  source: "body_main_short.tex, tab:results-cost-per-qualifying-pose"
  input: posebusters_results/benchmark_matched_equibind/docking_effort_gnina_v2_charged_nearest/effort_summary.csv
  rows:
    autodock: {complexes: 199, cpu_core_s_per_near2: 1752.8, gpu_s_per_near2: 118.9, poses_near2: 311}
    diffdock: {complexes: 169, cpu_core_s_per_near2: 2.93,   gpu_s_per_near2: 49.9,  poses_near2: 1622}
    equibind: {complexes: 80,  cpu_core_s_per_near2: 165.3,  gpu_s_per_near2: 1.4,   poses_near2: 466}
  note: >-
    The complexes column uses the VALIDITY-AWARE near-native gate
    (pb_valid AND rmsd <= 2), unlike Table 1's near-native column, which is
    unconditioned. That is why AutoDock reads 199 here and 202 there.

# -----------------------------------------------------------------------------
# Table 8 - AutoDock Exhaustiveness Ladder
# -----------------------------------------------------------------------------
# Recovery is the CONJUNCTION gate the caption states: a pose that is
# PoseBusters-valid AND within 2 A, among the first d ranks. That is not the
# gate the exh_yield_by_depth sidecar carries, whose four gates are each a single
# criterion, so this table is recomputed from the per-pose table instead.
#
# Ranking differs by arm. A raw rung orders by Vina `rank`; a rescored one orders
# by `optimized_rank`, which is gnina's CNNaffinity order over the same poses.
table_8:
  source: "body_appendix_short.tex, tab:appendix-exhaustiveness-ladder"
  input: posebusters_results/benchmark_matched_equibind/dock/pose_comparison_report_nearest/per_pose_metrics.csv
  depths: [1, 5, 15, 30]
  rows:
    autodock_mgltools_exh18:        {rank_col: rank,           counts: [72, 108, 121, 125]}
    autodock_mgltools:              {rank_col: rank,           counts: [85, 130, 148, 154]}
    autodock_mgltools_exh64:        {rank_col: rank,           counts: [94, 145, 175, 182]}
    autodock_mgltools_exh92:        {rank_col: rank,           counts: [91, 150, 182, 194]}
    autodock_mgltools_exh128:       {rank_col: rank,           counts: [94, 153, 185, 202]}
    autodock_mgltools_gnina:        {rank_col: optimized_rank, counts: [100, 144, 154, 154]}
    autodock_mgltools_exh64_gnina:  {rank_col: optimized_rank, counts: [110, 169, 182, 182]}
    autodock_mgltools_exh128_gnina: {rank_col: optimized_rank, counts: [111, 184, 198, 199]}
  note: >-
    The selected arm is exhaustiveness 128 with gnina rescoring. Note the raw
    exh128 rung leads it over the full pool, 202 against 199, because rescoring
    reorders a pool rather than extending it and a few poses cross the threshold
    the wrong way.

# -----------------------------------------------------------------------------
# Figure provenance
# -----------------------------------------------------------------------------
# The shipped asset must be byte-identical to the file the pipeline writes. This
# is the end-to-end check: it ties a rebuilt output to the image in the PDF.
#
# The three omissions are deliberate. Figures 22 and 27 are hand-composed PyMOL
# renders that exist nowhere in the repository, and Figure 17 is an author-drawn
# schematic. They cannot be regenerated and are not claimed to be.
figures:
  media_dir: thesis_latex_nearest/media/media
  pairs:
    image2:  posebusters_results/benchmark_matched_equibind/dock/validity_report_mgltools_nearest/00_figure2_validity_yield.png
    image3:  posebusters_results/benchmark_matched_equibind/dock/pose_comparison_report_nearest/18_topn_within_thresholds_pbvalid_depths.png
    image4:  posebusters_results/benchmark_matched_equibind/dock/pose_comparison_report_nearest/18_topn_within_thresholds_kabsch_pbvalid_depths.png
    image5:  posebusters_results/benchmark_matched_equibind/dock/pose_comparison_report_nearest/20d_form_vs_placement_by_family__depth_filmstrip_pbvalid__rank1_top5_top15__thesis.png
    image6:  posebusters_results/cluster_crystal_pocket_matched_equibind/autodock_mgltools_exh128_gnina__diffdock_smina_allposes_nearest/topN_crystal_cluster_matrix.png
    image7:  posebusters_results/cluster_crystal_pocket_matched_equibind/autodock_mgltools_exh128_gnina__diffdock_smina_allposes_nearest/crystal_cluster_homogeneity.png
    image8:  posebusters_results/cluster_crystal_pocket_matched_equibind/autodock_mgltools_exh128_gnina__diffdock_smina_allposes_nearest/cluster_quality_metrics.png
    image9:  pandamap_results/benchmark_matched_equibind_nearest/report/05_fingerprint_similarity_top5.png
    image11: pandamap_results/benchmark_matched_equibind_nearest/report/10b_contact_decomposition_by_rank.png
    image13: posebusters_results/_orai_matched_root/orai_pbvalid_yield_compare/09f_pbvalid_yield_dominant_orai_benchmark_vs_experimental.png
    image15: posebusters_results/_orai_matched_root/orai_pbvalid_tm_share_compare/fig_tm_loss_relative_compare.png
    image16: posebusters_results/_orai_matched_root/orai_jku/pose_clusters/panels/orai_cross_tool_agreement_compare.png
    image17: posebusters_results/_orai_matched_root/orai_jku/pose_clusters/panels/orai_tool_agreement_compare.png
    image18: posebusters_results/_orai_matched_root/orai_jku/pose_clusters/panels/orai_cluster_quality_compare.png
    image19: posebusters_results/_orai_matched_root/orai_benchmark/pose_clusters/orai_cluster_quality_filtering.png
    image21: pandamap_results/orai_interaction_compare_matched/fig_type_profile_compare.png
    image23: pandamap_results/orai_interaction_compare_matched/fig_fingerprint_overlap_compare.png
    image24: posebusters_results/benchmark_matched_equibind/docking_effort_gnina_v2_charged_nearest/panels/effort_by_quality_near2.png
    image25: posebusters_results/benchmark_matched_equibind/docking_effort_gnina_v2_nearest/panels/resource_per_near_native_valid_pose.png
    image43: posebusters_results/_orai_matched_root/orai_pbvalid_tm_share_compare/fig_pbvalid_outside_tm_whisker.png
    image44: posebusters_results/autodock_exhaustiveness_returns_nearest/figures/exh_raw_vs_rescored.png
    image45: posebusters_results/autodock_exhaustiveness_returns_nearest/figures/exh_depth_sweep.png
    image46: posebusters_results/autodock_exhaustiveness_returns_nearest/figures/exh_yield_vs_cost.png
    image47: posebusters_results/autodock_exhaustiveness_returns_nearest/figures/exh_marginal_return.png
    # ---------------------------------------------------------------------
    # Added 2026-09-03. Thirteen shipped assets had NO provenance pair, so
    # nothing tied them to a file the pipeline writes. Each was located by
    # hashing every PNG in the repository and matching on md5, not by name,
    # and every one of the thirteen is byte-identical to a live pipeline
    # output. Figures 25 and 26 were the consequential pair: they are
    # regeneration-tested by validate_regeneration.py but were absent here,
    # so the two layers disagreed about what was covered.
    # ---------------------------------------------------------------------
    image20: pandamap_results/orai_interaction_compare_matched/fig_total_interactions_compare.png
    image22: pandamap_results/orai_interaction_compare_matched/fig_residue_hotspots_compare.png
    # Figure 17, the docking flow chart. Author-drawn rather than computed, and
    # validate_regeneration.py rightly declines to re-render it. It still has a
    # single source file in the repository, so its provenance is checkable even
    # though its regeneration is not.
    image1:  docking_workflow.png
    # Figures 28 to 37, the chemical-space chapter. Byte-comparison of a
    # RE-RENDER is excluded by validate_regeneration.py because matplotlib moves
    # 1 to 2.5 per cent of pixels between runs. That is an argument against
    # re-rendering them, not against checking that the shipped asset is the file
    # the notebook last wrote, which is what these pairs establish.
    image33: PoseBusters_Benchmark_Analysis/figures/01_ligand_univariate_distributions.png
    image34: PoseBusters_Benchmark_Analysis/figures/02_druglikeness_ro5_qed.png
    image35: PoseBusters_Benchmark_Analysis/figures/03_elemental_charge_composition.png
    image36: PoseBusters_Benchmark_Analysis/figures/04_ligand_correlation_heatmap.png
    image37: PoseBusters_Benchmark_Analysis/figures/05_2d_attribute_mappings.png
    image38: PoseBusters_Benchmark_Analysis/figures/06_pairplot_core_descriptors.png
    image39: PoseBusters_Benchmark_Analysis/figures/09_pca_scree_loadings.png
    image40: PoseBusters_Benchmark_Analysis/figures/10_pca_biplot.png
    image41: PoseBusters_Benchmark_Analysis/figures/07_receptor_profile.png
    image42: PoseBusters_Benchmark_Analysis/figures/08_startconf_rmsd.png

  # Two shipped assets have no source anywhere in the repository and are
  # recorded here rather than left as a silent hole in the count. Both captions
  # disclaim measurement in the document itself, so nothing numeric depends on
  # them. A search of every PNG in the tree by md5 found each only inside
  # thesis_latex/obsolete/.backup-preswap-20260831-140025/, which is the
  # shipped copy itself and not a generator.
  unreproducible:
    image12:
      figure: 27
      what: The docking receptor, Fr300 cartoon
      why: >-
        One-off interactive PyMOL render. The scene builder exists at
        Scripts/Analysis/pymol_pose_cluster_scene.py but this particular view was
        composed by hand and never scripted. The caption states that it carries no
        measurement and that no quantity in the surrounding text is read from it.
    image14:
      figure: 22
      what: Orai Fr300 with docked ligands and transmembrane exclusion
      why: >-
        Same provenance and the same disclaimer. The exclusion slab, the pose sets
        and the residues that define them are specified in the Methods and in the
        surrounding text rather than read off this render.

prose:
  refiner_contrasts:
    source: "body_main_short.tex, Discussion, 'Physical Validity and Post-Docking Optimisation'"
    input: posebusters_results/benchmark_matched_equibind/dock/pose_comparison_report_nearest/per_pose_metrics.csv
    note: >-
      ADDED 2026-09-03. The Discussion compares the two refiners within each
      learned family, and NOTHING in the pipeline computes those contrasts.
      topk_recovery_stats.csv holds only raw-to-optimised pairs, and
      topk_recovery_validity.csv has no EquiBind + smina variant at all, so
      every number in that passage had to be derived by hand and none of it
      was checkable. The passage previously claimed neither within-family
      difference was statistically separable. That is true for DiffDock and
      true for EquiBind only on the selection endpoint. On near-nativeness
      the EquiBind arms separate at every depth.
      RANKING TRAP: both EquiBind arms carry rank == 999 for every row, and
      each arm populates ONLY its own refiner's affinity column. Ranking the
      smina arm by gnina_affinity yields an empty frame. Each arm must be
      ranked by its own column, ascending.
    equibind_near_top15:      {gnina: 83, smina: 61, mcnemar_p: 0.0001131}
    equibind_selection_top15: {gnina: 55, smina: 46, mcnemar_p: 0.1078}
    diffdock_triple_top15:    {smina: 133, gnina: 132, mcnemar_p: 1.0}
    diffdock_double_top15:    {smina: 167, gnina: 167, mcnemar_p: 1.0}
    diffdock_near_top15:      {smina: 170, gnina: 170, mcnemar_p: 1.0}
  appendix_h9:
    source: "body_appendix_short.tex, 'Resolution of the Two-Pipeline Contrast'"
    input: posebusters_results/benchmark_matched_equibind/dock/pose_comparison_report_nearest/per_pose_metrics.csv
    note: >-
      A whole section of prose with no float behind it. It carries the thesis's
      answer to its own headline question, namely whether the leading pair
      separates at rank-1, and every number in it was unasserted.
      ORIENTATION TRAP: bounded_claim() computes p_b - p_a with AutoDock as a and
      DiffDock as b, so its diff and interval are the NEGATION of what the
      appendix prints. The thesis quotes AutoDock minus DiffDock.
    arm_a: [autodock_mgltools_exh128_gnina, optimized_rank]
    arm_b: [diffdock_smina, rank]
    depths: [1, 5, 15, 30]
    diff_pp:   [2.6, 13.2, 10.2, 9.9]
    ci95_lo:   [-4.2, 5.7, 2.8, 2.5]
    ci95_hi:   [9.4, 20.4, 17.5, 17.1]
    mcnemar_p: [0.5085, 0.00076, 0.0090, 0.0113]
    rank1:
      both_recover: 51
      neither_recovers: 140
      discordant: 112
      discordant_pct: 37.0
      mde_pp: 9.8
      observed_power: 0.12
      n_needed: 4200
      mde_at_428: 8.2
    equivalence:
      note: >-
        TOST at alpha 0.05 is the 90 per cent Newcombe interval, so these bounds
        are NOT the 95 per cent ones above. The smallest passing margin is the
        larger absolute bound rounded UP to one decimal: a margin equal to the
        bound rounded down would not actually pass.
      ci90_lo: [-3.1, 6.9, 4.0, 3.7]
      ci90_hi: [8.3, 19.3, 16.3, 16.0]
      smallest_passing_margin: [8.4, 19.4, 16.4, 16.0]
      equivalent_within_10pp: [true, false, false, false]
      equivalent_within_5pp:  [false, false, false, false]

  figure_23:
    source: "body_appendix_short.tex, the paragraph on fig:results-r17"
    input: posebusters_results/_orai_matched_root/orai_jku/pose_clusters/cluster_quality_per_tool.csv
    pose_set: raw
    note: >-
      Medians are over the RAW pose cloud, which the caption specifies. Filtering
      to raw matters: over both pose sets AutoDock's compactness reads 0.42 and
      the quoted 0.62 looks wrong when it is not.
    compactness_median:
      autodock: 0.62
      diffdock: 0.34
      equibind: 1.53
    silhouette_median:
      autodock: 0.776
      diffdock: 0.174
      equibind: 0.587
  figure_24:
    source: "body_appendix_short.tex, the paragraph on fig:results-r18"
    input: posebusters_results/_orai_matched_root/orai_benchmark/pose_clusters/cluster_quality_per_tool.csv
    equibind_paired_stability_units: 46
    equibind_single_cluster_after_filtering: 39
    equibind_multicluster_units: 7
    equibind_multicluster_stability_raw: 0.67
    equibind_multicluster_stability_filtered: 0.74
  figure_39:
    source: "body_appendix_short.tex, the paragraph on fig:results-r9"
    input: pandamap_results/benchmark_matched_equibind_nearest/report/10b_contact_decomposition_by_rank.csv
    autodock_spurious_rank1: 15.3
    diffdock_spurious_rank1: 14.1
    autodock_spurious_rank5: 17.6
    equibind_matched_rank1: 16.7
    equibind_missed_rank1: 18.9
    equibind_spurious_min: 12.0
    equibind_spurious_max: 12.6

# -----------------------------------------------------------------------------
# Interaction pose-basis audit
# -----------------------------------------------------------------------------
# Appendix B's "Interaction Fingerprints" section quotes this audit verbatim.
#
# It joins the PandaMap fingerprint table to the per-pose table on
# (method, protein, ligand, pose_name) and aborts on a partial join. The abort is
# not a data fault: the PandaMap arm profiles 306 complexes while the analysed
# cohort is 303, so the audit must be restricted with --ids-file. Running it
# without one leaves nine EquiBind poses in three excluded complexes unjoined.
# The 303-id file is derived from per_pose_metrics rather than written by hand.
  audit:
    source: 'body_appendix_short.tex, "Interaction Fingerprints"'
    input: pandamap_results/benchmark_matched_equibind_nearest/report/interaction_pose_basis_audit.csv
    ids_file: posebusters_results/benchmark_matched_equibind/dock/pose_comparison_report_nearest/analysed_cohort_ids.txt
    profiled_poses: 4253
    profiled_complexes: 303
    median_rmsd: 7.57
    within_2a_pct: 21.3
    crude_f1: {autodock: 0.565, diffdock: 0.529, equibind: 0.471}
    standardised_f1: {autodock: 0.532, diffdock: 0.527, equibind: 0.513}
    site_filtered_overlap: {autodock: 0.683, diffdock: 0.714, equibind: 0.629}
    site_filtered_complexes: {autodock: 257, diffdock: 240, equibind: 155}
    dropped_by_site_filter: {autodock: 44, diffdock: 60, equibind: 111}
    metal_records: 6296
    metal_complexes: 121
