# AutoDock Vina local patch — boron AutoDock atom type (AD_TYPE_B)
#
# WHY THIS FILE EXISTS: the vina binary used for every AutoDock pose in this project is
# a PATCHED build. Without this patch the binary rejects ADFRsuite-prepared 2abp-nh2-OPT,
# whose boron is emitted as AutoDock type 'B' (the Meeko path maps B->C instead, via
# sanitize_pdbqt_atom_types, which is never called on the ADFRsuite ligand path).
# The patch was uncommitted and unpushed in /home/manndo/AutoDock-Vina, so nobody could
# rebuild the binary that produced the poses. Archived here 2026-08-30.
#
# Upstream base commit : 93cdc3d (Merge pull request #405 from joanimato/pip-win-macos)
# Built binary version : AutoDock Vina v1.2.7-20-g93cdc3d-mod
# Built binary sha256  : 2a84f93dd612e9fc95dceb3202233d5c7f044313cf531191eb6c02a5b1c8004b
#
# To reproduce:  git clone <vina>; git checkout 93cdc3d; git apply <this file>; make
#
diff --git a/src/lib/ad4cache.cpp b/src/lib/ad4cache.cpp
index 28e7844..e612d8c 100755
--- a/src/lib/ad4cache.cpp
+++ b/src/lib/ad4cache.cpp
@@ -49,6 +49,7 @@ std::string get_adtype_str(sz& t) {
 		case AD_TYPE_Br: return "Br";
 		case AD_TYPE_Si: return "Si";
 		case AD_TYPE_At: return "At";
+		case AD_TYPE_B : return "B";
 		case AD_TYPE_W : return "W";
 		default: VINA_CHECK(false);
 	}
