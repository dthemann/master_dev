    "def run_fpocket(pdb_file: Path):\n",
    "    name = pdb_file.stem  # e.g. \"5S8I_2LY_protein\"\n",
    "    out_dir = fpocket_results_folder / f\"{name}_out\"\n",
    "    if (out_dir / f\"{name}_info.txt\").exists():\n",
