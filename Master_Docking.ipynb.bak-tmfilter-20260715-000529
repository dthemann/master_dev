    "def _link(src: Path, dst: Path) -> bool:\n",
    "    if not src.exists():\n",
    "        return False\n",
    "    if dst.is_symlink() or dst.exists():\n",
    "        try:\n",
    "            if dst.resolve() == src.resolve():\n",
    "                return True\n",
    "        except OSError:\n",
    "            pass\n",
    "        dst.unlink()\n",
    "    try:\n",
    "        dst.symlink_to(src.resolve())\n",
    "    except OSError:\n",
    "        shutil.copy2(src, dst)\n",
    "    return True\n",
    "\n",
    "\n",
    "# ── 1. Stage receptors ──────────────────────────────────────────────────────\n",
    "n_rec = 0\n",
